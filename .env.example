# Morning Star — variables d'environnement (exemples uniquement, sans secrets)

# Application
# URL canonique du site (SEO, Open Graph, sitemap, robots)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Morning Star

# Données : "mock" (défaut en local sans Postgres) | "prisma" (futur)
DATA_SOURCE=mock

# Base de données (PostgreSQL — non connectée à cette étape)
DATABASE_URL=

# Authentification (à configurer ultérieurement)
AUTH_SECRET=
AUTH_ADMIN_EMAIL=

# Stockage fichiers (PDF/DOCX — futur)
STORAGE_PROVIDER=
STORAGE_BUCKET=

# Email / newsletter (futur)
EMAIL_PROVIDER=
EMAIL_FROM=

# Rate limiting (futur)
RATE_LIMIT_ENABLED=false
