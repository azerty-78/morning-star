# Morning Star — variables d'environnement (exemples uniquement, sans secrets)

# Application
# URL canonique du site (SEO, Open Graph, sitemap, robots)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Morning Star

# Données : "mock" (défaut, l'app ne se connecte pas encore à Postgres) | "prisma" (futur)
DATA_SOURCE=mock

# PostgreSQL — container morning-stard, base morning-star-db, réseau morning-star-network
# En local, Next tourne sur l'hôte (port 3000). Docker ne lance que la base.
# Mot de passe de développement uniquement. En production, le remplacer dans la CI.
POSTGRES_USER=morningstar
POSTGRES_PASSWORD=morningstar_local
POSTGRES_DB=morning-star-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://morningstar:morningstar_local@localhost:5432/morning-star-db

# URL du site servi par l'image Docker (port 4004). Ne change pas le port 3000 local.
# NEXT_PUBLIC_APP_URL_PRODUCTION=http://localhost:4004

# Authentification (à configurer ultérieurement)
AUTH_SECRET=
AUTH_ADMIN_EMAIL=

# Stockage fichiers (PDF/DOCX — futur)
# vide ou "none" | "local" | "s3"
STORAGE_PROVIDER=
STORAGE_BUCKET=

# Email / newsletter
# mock (défaut) | plus tard : resend | ses | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@morning-star.local

# Rate limiting (futur)
RATE_LIMIT_ENABLED=false
